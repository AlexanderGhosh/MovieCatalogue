[Unit]
Description=Movie Catalogue Blazor App
After=network.target
Requires=mssql-server.service

[Service]
WorkingDirectory=/var/www/MovieCatalogue
ExecStart=/usr/bin/dotnet /var/www/MovieCatalogue/MovieApp.Web.dll
Restart=always
RestartSec=10
User=alex-admin
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://0.0.0.0:80

[Install]
WantedBy=multi-user.target