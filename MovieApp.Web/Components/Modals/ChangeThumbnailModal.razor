@using BlobStorage
@using MovieApp.Web.Services.Abstractions

<label>Movie Thumbnail</label>
<InputFile OnChange="ThumbnailChange" accept=".jpg,.jpeg,.jpe,.jfif,.jif,.jfi,.pjpeg,.pjp,.png,.webp" />
<button type="button" class="btn btn-primary" @onclick="@Close">
    Close
</button>

@code {
    public enum ItemMode
    {
        Movie,
        Collection
    }
    [Parameter]
    public int Id { get; set; }
    [Parameter]
    public ItemMode Mode { get; set; } = ItemMode.Movie;

    [Inject]
    public IMovieService _movieService { get; set; } = null!;
    private IBrowserFile? _thumbnail;
    [CascadingParameter]
    BlazoredModalInstance BlazoredModal { get; set; } = default!;

    private async Task SaveChange()
    {
        if (_thumbnail is null) return;
        using var stream = _thumbnail.OpenReadStream();
        var extension = Path.GetExtension(_thumbnail.Name);
        var contentType = BlobContentTypes.GetContentType(extension);
        switch(Mode)
        {
            case ItemMode.Movie:
                await _movieService.SetMovieThumbnail(Id, stream, contentType);
                break;
            case ItemMode.Collection:
                await _movieService.SetCollectionThumbnail(Id, stream, contentType);
                break;
        }
        await Close();   
    }

    private async Task ThumbnailChange(InputFileChangeEventArgs args)
    {
        _thumbnail = args.File;
        await SaveChange();
    }

    private Task Close() => BlazoredModal.CloseAsync();
}
