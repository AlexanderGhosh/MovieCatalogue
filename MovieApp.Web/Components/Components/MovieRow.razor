@using MovieApp.Web.Models;
@using MovieApp.Web.Services.Abstractions
<tr @ondrag="OnDrag"
@onmouseover="() => _mousedOver = true">
    @if (ShowThumbnail && Movie.ShowThumbnail)
    {
        <td>
            <div style="display:flex;">
                <ThumbnailComponent Image="@($"/api/Video/{Movie.Id}/thumbnail")" Width="90" OnClick="WatchMovie" />
                <a @onclick="ThumbnailEdit">
                    <i class="bi bi-pencil-fill"></i>
                </a>
            </div>
        </td>
    }
    <td>
        @if (_nameEditing)
        {
            <input @bind="_nameEditValue" class="form-control form-control-sm d-inline w-auto" @onkeypress="NameEditKeyPress" />

            <a class="btn btn-link p-0 ms-2" @onclick="SaveNameEdit" title="Save">
                <i class="bi bi-check-circle-fill"></i>
            </a>

            <a class="btn btn-link p-0 ms-1 text-danger" @onclick="EndNameEdit"title="Cancel">
                <i class="bi bi-x-circle-fill"></i>
            </a>
        }
        else
        {
            @Movie.Title
            @if (NameEditable)
            {
                <a @onclick="BeginNameEdit">
                    <i class="bi bi-pencil-fill"></i>
                </a>
            }
        }
    </td>
    <td>
        @Movie.AddedOn.ToShortDateString()
    </td>
    @if (!_nameEditing)
    {
        <td>
            <a href="@_moviePath">
                Watch    
            </a>
        </td>
    }
    @if (Downloadable)
    {
        <td>
            <a href="@($"/api/Video/{Movie.Id}?download=true")" class="btn btn-link p-0 ms-2" title="Download" download>
                <i class="bi bi-download"></i>
            </a>
        </td>
    }
    <td @onclick="RemoveMovie_CB" title="Remove">
        <i class="bi bi-x-circle"></i>
    </td>
</tr>

@code {
    [Parameter]
    public required Movie Movie { get; init; }
    [Parameter]
    public bool Downloadable { get; set; } = true;
    [Parameter]
    public bool NameEditable { get; set; } = false;
    [Parameter]
    public bool ShowThumbnail { get; set; } = true;
    [Parameter]
    public Func<Movie, Task>? RemoveMovie { get; init; }

    private readonly IModalService _modalSvc;
    private readonly IMovieService _movieSvc;
    private readonly IDragDropService _dragDropService;
    private string _nameEditValue = string.Empty;
    private bool _nameEditing;
    private bool _mousedOver;
    private string _moviePath => $"/movieview/{Movie.Id}";

    public MovieRow(IModalService modalService, IMovieService movieService, IDragDropService dragDropService)
    {
        _modalSvc = modalService;
        _movieSvc = movieService;
        _dragDropService = dragDropService;
    }

    void WatchMovie()
    {
        if (_nameEditing) return;
        Navigation.NavigateTo(_moviePath);
    }

    async Task RemoveMovie_CB()
    {
        var task = RemoveMovie?.Invoke(Movie);
        if (task is not null)
            await task;
    }

    void BeginNameEdit()
    {
        _nameEditValue = Movie.Title;
        _nameEditing = true;
        StateHasChanged();
    }

    async Task SaveNameEdit()
    {
        if (_nameEditValue == Movie.Title) return;
        Movie.Title = _nameEditValue;
        await _movieSvc.UpdateMovie(Movie.Id, m => m.Title = _nameEditValue);
        StateHasChanged();
        EndNameEdit();
    }

    void EndNameEdit()
    {
        _nameEditing = false;
    }

    async Task NameEditKeyPress(KeyboardEventArgs args)
    {
        switch(args.Key)
        {
            case "Enter":
                await SaveNameEdit();
                break;
            case "Escape":
                EndNameEdit();
                break;
        }
    }

    void OnDrag()
    {
        _dragDropService.BeginDrag(Movie);
    }

    async Task ThumbnailEdit()
    {
        var parmas = new ModalParameters()
        {
            {nameof(ChangeThumbnailModal.MovieId), Movie.Id}
        };
        var modal = _modalSvc.Show<ChangeThumbnailModal>(parmas);
        await modal.Result;
        StateHasChanged();
    }
}