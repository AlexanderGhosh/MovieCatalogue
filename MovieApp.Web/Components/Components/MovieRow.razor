@using MovieApp.Web.Models;
@using MovieApp.Web.Services.Abstractions
<tr draggable="true"
    @ondrag="OnDrag"
    @onclick="WatchMovie">
    @if (ShowThumbnail && Movie.ShowThumbnail)
    {
        <td>
            <div style="display:flex;">
                <ThumbnailComponent Image="@($"/api/Video/{Movie.Id}/thumbnail?t={Movie.ThumbnailBlobId}")" Width="90" />
                <a @onclick="ThumbnailEdit" @onclick:stopPropagation="true" @onclick:preventDefault="true">
                    <i class="bi bi-pencil-fill"></i>
                </a>
            </div>
        </td>
    }
    <td>
        @if (_nameEditing)
        {
            <input @bind="_nameEditValue" class="form-control form-control-sm d-inline w-auto" @onkeypress="NameEditKeyPress" @onclick:stopPropagation="true" @onclick:preventDefault="true" />

            <a class="btn btn-link p-0 ms-2" @onclick="SaveNameEdit" @onclick:stopPropagation="true" @onclick:preventDefault="true" title="Save">
                <i class="bi bi-check-circle-fill"></i>
            </a>

            <a class="btn btn-link p-0 ms-1 text-danger" @onclick="EndNameEdit" @onclick:stopPropagation="true" @onclick:preventDefault="true" title="Cancel">
                <i class="bi bi-x-circle-fill"></i>
            </a>
        }
        else
        {
            @Movie.Title
            @if (NameEditable)
            {
                <a @onclick="BeginNameEdit" @onclick:stopPropagation="true" @onclick:preventDefault="true">
                    <i class="bi bi-pencil-fill"></i>
                </a>
            }
        }
    </td>
    <td class="hide-1100">
        @Movie.AddedOn.ToShortDateString()
    </td>
    @if (Downloadable)
    {
        <td class="hide-1100">
            <a href="@($"/api/Video/{Movie.Id}?download=true")" class="btn btn-link p-0 ms-2" title="Download" download @onclick:stopPropagation="true">
                <i class="bi bi-download"></i>
            </a>
        </td>
    }
    <td @onclick="RemoveMovie_CB" @onclick:stopPropagation="true" @onclick:preventDefault="true" title="Remove" class="hide-1100">
        <i class="bi bi-x-circle"></i>
    </td>
</tr>

@code {
    [Parameter]
    public required Movie Movie { get; init; }
    [Parameter]
    public bool Downloadable { get; set; } = true;
    [Parameter]
    public bool NameEditable { get; set; } = false;
    [Parameter]
    public bool ShowThumbnail { get; set; } = true;
    [Parameter]
    public Func<Movie, Task>? RemoveMovie { get; init; }

    private readonly IModalService _modalSvc;
    private readonly IMovieService _movieService;
    private readonly IDragDropService _dragDropService;
    private string _nameEditValue = string.Empty;
    private bool _nameEditing;
    private string _moviePath => $"/movie/{Movie.Id}";

    public MovieRow(IModalService modalService, IMovieService movieService, IDragDropService dragDropService)
    {
        _modalSvc = modalService;
        _movieService = movieService;
        _dragDropService = dragDropService;
    }

    void WatchMovie()
    {
        if (_nameEditing) return;
        Navigation.NavigateTo(_moviePath);
    }

    async Task RemoveMovie_CB()
    {
        var task = RemoveMovie?.Invoke(Movie);
        if (task is not null)
            await task;
    }

    void BeginNameEdit()
    {
        _nameEditValue = Movie.Title;
        _nameEditing = true;
        StateHasChanged();
    }

    async Task SaveNameEdit()
    {
        if (_nameEditValue == Movie.Title) return;
        Movie.Title = _nameEditValue;
        await _movieService.UpdateMovie(Movie.Id, m => m.Title = _nameEditValue);
        StateHasChanged();
        EndNameEdit();
    }

    void EndNameEdit()
    {
        _nameEditing = false;
    }

    async Task NameEditKeyPress(KeyboardEventArgs args)
    {
        switch(args.Key)
        {
            case "Enter":
                await SaveNameEdit();
                break;
            case "Escape":
                EndNameEdit();
                break;
        }
    }

    void OnDrag()
    {
        _dragDropService.BeginDrag(Movie);
    }

    async Task ThumbnailEdit()
    {
        var parmas = new ModalParameters()
        {
            {nameof(ChangeThumbnailModal.Id), Movie.Id},
            {nameof(ChangeThumbnailModal.Mode), ChangeThumbnailModal.ItemMode.Movie}
        }; 
        var options = new ModalOptions()
        {
            Class = "lcars-modal",
            Position = ModalPosition.TopCenter
        };
        var modal = _modalSvc.Show<ChangeThumbnailModal>(parmas, options);
        await modal.Result;
        StateHasChanged();
    }
}