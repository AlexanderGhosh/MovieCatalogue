@using MovieApp.Web.Models
@using MovieApp.Web.Services.Abstractions
<tr draggable="true"
    @onclick="GotoCollection" 
    @ondrag="OnDrag"
    @ondrop="OnDropEvent"
    @ondragover:preventDefault="true">
    @if (ShowThumbnail && Collection.ShowThumbnail)
    {
        <td>
            <div style="display:flex;">
                <ThumbnailComponent Image="@($"/api/Video/{Collection.Id}/thumbnail?isCollection=true&t={Collection.ThumbnailBlobId}")" Width="90" />
                <a @onclick="ThumbnailEdit" @onclick:stopPropagation="true" @onclick:preventDefault="true">
                    <i class="bi bi-pencil-fill"></i>
                </a>
            </div>
        </td>
    }
    <td>
        <h5>@Collection.Name</h5>
        <p>Items: @(Collection.Movies.Count + Collection.ChildCollections.Count)</p>
    </td>
    <td class="hide-1100">
        @Collection.AddedOn.ToShortDateString()
    </td>
    <td class="hide-1100" />
    <td @onclick="RemoveCB" @onclick:stopPropagation="true" class="hide-1100">
        <i class="bi bi-x-circle"></i>
    </td>
</tr>

@code {
    private readonly IMovieService _movieService;
    private readonly IDragDropService _dragDropService;
    private readonly IModalService _modalService;

    [Parameter]
    public required MovieCollection Collection { get; init; }
    [Parameter]
    public Func<MovieCollection, Task>? RemoveCollection { get; init; }
    [Parameter]
    public bool ShowThumbnail { get; set; } = true;
    [Parameter]
    public Action<object>? OnDropped { get; init; }

    public CollectionRow(IModalService modalService, IMovieService service, IDragDropService dragDropService)
    {
        _modalService = modalService;
        _movieService = service;
        _dragDropService = dragDropService;
    }

    void GotoCollection()
    {
        Navigation.NavigateTo($"/collection/{Collection.Id}");
        StateHasChanged();
    }

    async Task RemoveCB()
    {
        var task = RemoveCollection?.Invoke(Collection);
        if (task is not null)
            await task;
    }

    void OnDrag()
    {
        _dragDropService.BeginDrag(Collection);
    }

    async Task OnDropEvent()
    {
        var dropped = _dragDropService.EndDrag();
        switch (dropped)
        {
            case MovieCollection collection:
                if (collection.Id == Collection.Id) return;
                await _movieService.AddCollectionToCollection(Collection.Id, collection.Id);
                break;
            case Movie movie:
                await _movieService.AddMovieToCollection(movie.Id, Collection.Id);
                break;
        }
        OnDropped?.Invoke(dropped);
    }

    async Task ThumbnailEdit()
    {
        var parmas = new ModalParameters()
        {
            {nameof(ChangeThumbnailModal.Id), Collection.Id},
            {nameof(ChangeThumbnailModal.Mode), ChangeThumbnailModal.ItemMode.Collection}
        };
        var options = new ModalOptions()
        {
            Class = "lcars-modal",
            Position = ModalPosition.TopCenter
        };
        var modal = _modalService.Show<ChangeThumbnailModal>(parmas, options);
        await modal.Result;
        StateHasChanged();
    }
}
