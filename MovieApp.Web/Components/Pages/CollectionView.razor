@using MovieApp.Web.Models
@page "/collection/{CollectionId:int}"

<a href="/" class="btn btn-link p-0 mb-3">
    <i class="bi bi-arrow-left"/>
    All movies
</a>

@if(_collection is null)
{
    <PageTitle>Loading...</PageTitle>
    <p>Loading...</p>
}
else
{
    <PageTitle>@(_collection.Name)</PageTitle>
    <h1 class="mb-0">@_collection.Name</h1>
    <table class="table">
        <thead>
            <tr>
                <th>Title</th>
                <th>AddedOn</th>
                <th></th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var movie in _collection.Movies)
            {
                <MovieRow Movie="movie" ShowThumbnail=@true NameEditable="@true" RemoveMovie="RemoveFromCollection" />
            }
            @foreach (var collection in _collection.ChildCollections)
            {
                <CollectionRow Collection="collection" RemoveCollection="RemoveFromCollection" OnDropped="_ => StateHasChanged()"/>
            }
        </tbody>
    </table>
}

@code {
    [Parameter]
    public required int CollectionId { get; init; }

    private MovieCollection? _collection;
    private readonly IMovieService _movieService;

    public CollectionView(IMovieService movieService)
    {
        _movieService = movieService;
    }

    protected override async Task OnParametersSetAsync()
    {
        _collection = (await _movieService.GetCollection(CollectionId))!;
        await base.OnParametersSetAsync();
    }

    private async Task RemoveFromCollection(Movie movie)
    {
        await _movieService.RemoveMovieFromCollection(movie.Id, CollectionId);
        StateHasChanged();
    }

    private async Task RemoveFromCollection(MovieCollection collection)
    {
        await _movieService.RemoveCollectionFromCollection(collection.Id, CollectionId);
        StateHasChanged();
    }
}
