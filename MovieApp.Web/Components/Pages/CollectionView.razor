@page "/collection/{CollectionId:int}"
@rendermode InteractiveServer
@using MovieApp.Web.Models

<PageTitle>@(_collection?.Name ?? "Collection")</PageTitle>

<a href="/" class="btn btn-link p-0 mb-3"><i class="bi bi-arrow-left"></i> All movies</a>

@if (!_loaded)
{
    <p>Loading...</p>
}
else if (_collection is null)
{
    <p>Collection not found.</p>
}
else
{
    <div class="d-flex align-items-center mb-3">
        @if (_renaming)
        {
            <input @bind="_newName" @bind:event="oninput" @onkeydown="OnRenameKeyDown"
                   class="form-control form-control-sm d-inline w-auto" />
            <button type="button" class="btn btn-link p-0 ms-2" @onclick="SaveRename" title="Save">
                <i class="bi bi-check-circle-fill"></i>
            </button>
            <button type="button" class="btn btn-link p-0 ms-1 text-danger" @onclick="CancelRename" title="Cancel">
                <i class="bi bi-x-circle-fill"></i>
            </button>
        }
        else
        {
            <h1 class="mb-0">@_collection.Name</h1>
            <button type="button" class="btn btn-link p-0 ms-2" @onclick="StartRename" title="Rename">
                <i class="bi bi-pencil-fill"></i>
            </button>
            <button type="button" class="btn btn-link p-0 ms-2 text-danger" @onclick="DeleteCollection" title="Delete collection (movies are kept)">
                <i class="bi bi-trash-fill"></i>
            </button>
        }
    </div>

    @if (_movies.Length == 0)
    {
        <p class="text-muted">This collection is empty.</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>AddedOn</th>
                    <th></th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var movie in _movies)
                {
                    <MovieRow Movie="movie" RemoveMovie="_ => RemoveMovie(movie)" ShowThumbnail=@false/>
                }
            </tbody>
        </table>
    }

    @if (_available.Length > 0)
    {
        <div class="d-flex align-items-center mt-4">
            <select class="form-select form-select-sm w-auto" @bind="_selectedToAdd">
                <option value="">Add a movie...</option>
                @foreach (var movie in _available)
                {
                    <option value="@movie.Id">@movie.Title</option>
                }
            </select>
            <button type="button" class="btn btn-primary btn-sm ms-2" @onclick="AddSelectedMovie" disabled="@(string.IsNullOrEmpty(_selectedToAdd))">
                Add
            </button>
        </div>
    }
}
