@using MovieApp.Web.Components.Components
@using MovieApp.Web.Extensions
@using MovieApp.Web.Helpers
@using MovieApp.Web.Models
@using MovieApp.Web.Services.Abstractions
@page "/collection/{CollectionId:int}"

<a href="/" class="btn btn-link p-0 mb-3">
    <i class="bi bi-arrow-left"/>
    All movies
</a>

@if(_collection is null)
{
    <Loading />
}
else
{
    <PageTitle>@(_collection.Name)</PageTitle>
    <h1 class="mb-0">@_collection.Name</h1>
    <div class="d-flex align-items-center mt-4">
        <select class="form-select form-select-sm w-auto" @bind="_selectedToAdd">
            <option value="">Add a movie...</option>
            @foreach (var movie in _available)
            {
                <option value="@movie.Id">@movie.Title</option>
            }
        </select>
        <button type="button" class="btn btn-primary btn-sm ms-2" @onclick="AddSelectedMovie" disabled="@(string.IsNullOrEmpty(_selectedToAdd))">
            Add
        </button>

      @*   <SearchBar Placeholder="SEARCH LIBRARY..."
                   @bind-Value="_searchString" /> *@
    </div>
    <div class="table-scroll">
        <table class="table-bluey">
            <thead>
                <tr>
                    <th>Thumbnail</th>
                    <th>Title</th>
                    <th class="hide-1100">Added on</th>
                    <th class="hide-1100">Download</th>
                    <th class="hide-1100">Remove</th>
                </tr>
            </thead>
            <tbody>
@*                 @foreach (var item in string.IsNullOrWhiteSpace(_searchString) ? Items : Items.Where(x => x.Name.Contains(_searchString, StringComparison.OrdinalIgnoreCase)))
                {
                    @if (item is MovieCollection collection)
                    {
                        <CollectionRow Collection="collection" OnDropped="_ => StateHasChanged()" RemoveCollection="RemoveFromCollection" />
                    }
                    else if (item is Movie movie)
                    {
                        <MovieRow Movie="movie" RemoveMovie="RemoveFromCollection" NameEditable="true" />
                    }
                } *@
                @foreach (var movie in _collection.Movies.OrderBy(SortingOperations.OrderByEpisode))
                {
                    <MovieRow Movie="movie" ShowThumbnail=@true NameEditable="@true" RemoveMovie="RemoveFromCollection" />
                }
                @foreach (var collection in _collection.ChildCollections)
                {
                    <CollectionRow Collection="collection" RemoveCollection="RemoveFromCollection" OnDropped="_ => StateHasChanged()" />
                }
            </tbody>
        </table>
    </div>
}

@code {
    [CascadingParameter]
    public MainLayout Layout { get; set; } = default!;
    [Parameter]
    public required int CollectionId { get; init; }
    private string? _selectedToAdd;
    private IEnumerable<Movie> _available;
    private string _searchString = string.Empty;
    private SortOptions _sortOptions = SortOptions.Default;
    private bool _reverseOrder = false;

    private MovieCollection? _collection;
    private readonly IMovieService _movieService;
    private IEnumerable<IMovieItem> _topLevelMovies;
    private IEnumerable<IMovieItem> _topLevelCollections;
    private IEnumerable<IMovieItem> Items
    {
        get
        {
            var defaultSort = _reverseOrder
                ? _topLevelMovies.Concat(_topLevelCollections)
                : _topLevelCollections.Concat(_topLevelMovies);
            return _sortOptions switch
            {
                SortOptions.Default => defaultSort,
                SortOptions.CollectionsOnly => _topLevelCollections,
                SortOptions.MoviesOnly => _topLevelMovies,
                SortOptions.AddedOn => defaultSort.OrderBy(x => x.AddedOn, _reverseOrder),
                SortOptions.Name => defaultSort.OrderBy(x => x.Name, _reverseOrder),
                _ => defaultSort,
            };
        }
    }

    public CollectionView(IMovieService movieService)
    {
        _movieService = movieService;
        _available = [];
        _topLevelMovies = [];
        _topLevelCollections = [];
    }

    protected override async Task OnInitializedAsync()
    {
        _available = await _movieService.GetAllMoviesAsync();
        await base.OnInitializedAsync();
        Layout.OnClickButton1 = _ => _sortOptions = SortOptions.Default;
        Layout.OnClickButton2 = _ => _sortOptions = SortOptions.Name;
        Layout.OnClickButton3 = _ => _sortOptions = SortOptions.AddedOn;
        Layout.OnClickButton4 = _ => _reverseOrder ^= true;
    }

    protected override async Task OnParametersSetAsync()
    {
        _collection = (await _movieService.GetCollection(CollectionId))!;
        _topLevelMovies = (await _movieService.GetAllMoviesAsync()).Where(x => x.Collections.Count == 0).OrderBy(SortingOperations.OrderByEpisode);
        _topLevelCollections = (await _movieService.GetAllCollectionsAsync()).Where(x => x.ParentCollections.Count == 0);
        await base.OnParametersSetAsync();
    }

    private async Task RemoveFromCollection(Movie movie)
    {
        await _movieService.RemoveMovieFromCollection(movie.Id, CollectionId);
        StateHasChanged();
    }

    private async Task RemoveFromCollection(MovieCollection collection)
    {
        await _movieService.RemoveCollectionFromCollection(collection.Id, CollectionId);
        StateHasChanged();
    }

    private async Task AddSelectedMovie()
    {
        if (!int.TryParse(_selectedToAdd, out var movieId)) return;
        await _movieService.AddMovieToCollection(movieId, CollectionId);
        StateHasChanged();
    }
}
