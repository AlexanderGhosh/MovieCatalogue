@page "/"
@rendermode InteractiveServer
@using MovieApp.Web.Models
@inject IJSRuntime JS

<PageTitle>Movies</PageTitle>

<h1>Movies</h1>

<div class="d-flex align-items-center mb-3">
    <button type="button" class="btn btn-primary" @onclick="@AddMovie">
        Add Movie
    </button>

    @if (_creatingCollection)
    {
        <input @bind="_newCollectionName" @bind:event="oninput" @onkeydown="OnCollectionKeyDown"
               class="form-control form-control-sm d-inline w-auto ms-3" placeholder="Collection name" />
        <button type="button" class="btn btn-link p-0 ms-2" @onclick="SaveCollection" title="Create">
            <i class="bi bi-check-circle-fill"></i>
        </button>
        <button type="button" class="btn btn-link p-0 ms-1 text-danger" @onclick="CancelCreateCollection" title="Cancel">
            <i class="bi bi-x-circle-fill"></i>
        </button>
    }
    else
    {
        <button type="button" class="btn btn-outline-primary ms-2" @onclick="StartCreateCollection">
            New Collection
        </button>
    }
</div>

<table class="table align-middle">
    <thead>
        <tr>
            <th>Title</th>
            <th>AddedOn</th>
            <th>Add to collection</th>
            <th></th>
            <th></th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Items)
        {
            @if (item.Collection is { } collection)
            {
                var count = CountIn(collection);
                <tr class="collection-row">
                    <td>
                        <i class="bi bi-collection-fill me-2"></i>
                        <a href="@($"/collection/{collection.Id}")" class="text-decoration-none fw-semibold">@collection.Name</a>
                        <span class="text-muted small ms-2">@count @(count == 1 ? "movie" : "movies")</span>
                    </td>
                    <td>@collection.AddedOn.ToShortDateString()</td>
                    <td></td>
                    <td>
                        <a href="@($"/collection/{collection.Id}")" class="btn btn-secondary">Open</a>
                    </td>
                    <td></td>
                    <td></td>
                </tr>
            }
            else if (item.Movie is { } movie)
            {
                <tr>
                    <td>
                        @if (ReferenceEquals(_editingMovie, movie))
                        {
                            <input @bind="_newTitle" class="form-control form-control-sm d-inline w-auto" />

                            <button type="button" class="btn btn-link p-0 ms-2" @onclick="SaveRename" title="Save">
                                <i class="bi bi-check-circle-fill"></i>
                            </button>

                            <button type="button" class="btn btn-link p-0 ms-1 text-danger" @onclick="CancelRename" title="Cancel">
                                <i class="bi bi-x-circle-fill"></i>
                            </button>
                        }
                        else
                        {
                            <a href="@($"/movie/{movie.Id}")" class="text-decoration-none">
                                <ThumbnailComponent Image="@ThumbUrl(movie.Id)" Width="90" AspectRatio="258.0f / 312.0f" />
                                <a @onclick="() => ChangeThumbnail(movie.Id)"
                                   @onclick:stopPropagation="true"
                                   @onclick:preventDefault="true">
                                    <i class="bi bi-film me-2"></i>
                                </a>
                                @movie.Title
                            </a>
                            <button type="button" class="btn btn-link p-0 ms-2" @onclick="() => StartRename(movie)" title="Rename">
                                <i class="bi bi-pencil-fill"></i>
                            </button>
                        }
                    </td>
                    <td>@movie.AddedOn.ToShortDateString()</td>
                    <td>
                        @if (_collections.Length > 0)
                        {
                            <select class="form-select form-select-sm w-auto"
                                    @onchange="e => AssignCollection(movie, e.Value?.ToString())">
                                <option value="">Choose...</option>
                                @foreach (var c in _collections)
                                {
                                    <option value="@c.Id">@c.Name</option>
                                }
                            </select>
                        }
                    </td>
                    <td>
                        <a href="@($"/movie/{movie.Id}")" class="btn btn-secondary">Watch</a>
                    </td>
                    <td>
                        <a href="@($"/api/Video/{movie.Id}?download=true")" class="btn btn-link p-0 ms-2" title="Download" download>
                            <i class="bi bi-download"></i>
                        </a>
                    </td>
                    <td>
                        <button type="button" class="btn btn-link p-0 ms-2" @onclick="() => DeleteMovie(movie)" title="Delete">
                            <i class="bi bi-trash-fill"></i>
                        </button>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

@code {
    private Dictionary<int, long> thumbVersions = new();
    private Movie? _editingMovie;
    private string _newTitle = string.Empty;

    private string ThumbUrl(int id) =>
    $"/api/Video/{id}/thumbnail?v={(thumbVersions.TryGetValue(id, out var v) ? v : 0)}";


    private void StartRename(Movie movie)
    {
        _editingMovie = movie;
        _newTitle = movie.Title;
    }

    private void CancelRename()
    {
        _editingMovie = null;
        _newTitle = string.Empty;
    }

    private async Task SaveRename()
    {
        if (_editingMovie is null) return;
        await RenameMovie(_editingMovie, _newTitle);
        _editingMovie = null;
        _newTitle = string.Empty;
    }
}