@page "/movies"

<PageTitle>Movies</PageTitle>

<h1>Movies</h1>


<table class="table">
    <thead>
        <tr>
            <th>Title</th>
            <th>AddedOn</th>
            <th>
                <button type="button" class="btn btn-primary" @onclick="@(() => Modal.Show<AddMovieModal>())">
                    Add Movie
                </button>
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var movie in _movies)
        {
            <tr>
                <td>@movie.Title</td>
                <td>@movie.AddedOn.ToShortDateString()</td>
                <td>
                    <button @onclick="@(() => WatchMovie(movie))">Watch</button>
                </td>
            </tr>
        }
    </tbody>
</table>