@page "/"
@rendermode InteractiveServer
@using MovieApp.Web.Components.Components
@using MovieApp.Web.Models
@inject IJSRuntime JS

<div>
    <PageTitle>Movies</PageTitle>

    <h1>Movies</h1>

    <div>
        <button type="button" @onclick="@AddMovie" class="lcars-button lcars-button-inline">
            Add Movie
        </button>
        <span class="hop"/>
        @if (_creatingCollection)
        {
            <input @bind="_newCollectionName" @bind:event="oninput" @onkeydown="OnCollectionKeyDown"
                   class="form-control form-control-sm d-inline w-auto ms-3" placeholder="Collection name" />
            <button type="button" class="btn btn-link p-0 ms-2" @onclick="SaveCollection" title="Create">
                <i class="bi bi-check-circle-fill"></i>
            </button>
            <button type="button" class="btn btn-link p-0 ms-1 text-danger" @onclick="CancelCreateCollection" title="Cancel">
                <i class="bi bi-x-circle-fill"></i>
            </button>
        }
        else
        {
            <button type="button" @onclick="StartCreateCollection" class="lcars-button lcars-button-inline">
                New Collection
            </button>
        }
        <SearchBar 
            Placeholder="SEARCH LIBRARY..."
            @bind-Value="_searchString"/>
    </div>

    <div class="table-scroll">
        <table class="table-bluey">
            <thead>
                <tr>
                    <th>Thumbnail</th>
                    <th>Title</th>
                    <th class="hide-1100">Added on</th>
                    <th class="hide-1100">Download</th>
                    <th class="hide-1100">Remove</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in string.IsNullOrWhiteSpace(_searchString) ? Items : Items.Where(x => x.Name.Contains(_searchString, StringComparison.OrdinalIgnoreCase)))
                {
                    @if (item is MovieCollection collection)
                    {
                        <CollectionRow Collection="collection" OnDropped="_ => StateHasChanged()" RemoveCollection="RemoveCollection" />
                    }
                    else if (item is Movie movie)
                    {
                        <MovieRow Movie="movie" RemoveMovie="DeleteMovie" NameEditable="true" />
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    async Task RemoveCollection(MovieCollection collection)
    {
        await _movieSvc.DeleteCollection(collection.Id);
    }
}