@using MovieApp.Web.Components.Components
@using MovieApp.Web.Models;
@using MovieApp.Web.Services.Abstractions
@page "/Movie/{MovieId:int}"
@if(_movie is null)
{
    <Loading/>
    return;
}

<PageTitle>@_movie?.Title</PageTitle>
<style>
    .primary{
        display: grid ;
        grid-template-columns: repeat(2, 1fr);
        padding: 10px;
    }
</style>
<div style="background-color: black;">
    <div class="primary">
        <MoviePlayer MovieId="@MovieId" ResumeAt="_movie.PausedAt" OnPaused="MoviePaused" />
        <div>
            <p style="color: white;">@_movie?.Title</p>
            <p style="color: mediumpurple;">@_movie?.Description</p>
        </div>
    </div>
</div>

@code {
    const float EndOfMovieWindow_Ratio = 0.05f;
    const float StartOfMovieWindow_Ratio = 0.05f;
    private readonly IMovieService _movieService;
    private Movie? _movie;

    [Parameter]
    public required int MovieId { get; set; }

    public MovieView(IMovieService movieService)
    {
        _movieService = movieService;
    }

    protected override async Task OnInitializedAsync()
    {
        _movie = await _movieService.GetMovie(MovieId);
        await base.OnInitializedAsync();
    }

    private async Task MoviePaused(MoviePlayer.OnPausedEventArgs args)
    {
        var delta = args.TotalDuration - args.PausedAt;
        var deltaSeconds = delta.TotalSeconds;
        TimeSpan? value = args.PausedAt;
        if (deltaSeconds <= EndOfMovieWindow_Ratio * args.TotalDuration.TotalSeconds || deltaSeconds <= StartOfMovieWindow_Ratio * args.TotalDuration.TotalSeconds) value = null;
        await _movieService.UpdateMovie(MovieId, m => m.PausedAt = value);
    }
}
