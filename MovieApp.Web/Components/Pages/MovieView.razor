@using MovieApp.Web.Models;
@page "/MovieView/{MovieId:int}"
<PageTitle>@_movie!.Title</PageTitle>
<style>
    .primary{
        display: grid ;
        grid-template-columns: repeat(2, 1fr);
        background-color: dodgerblue;
        padding: 10px;
    }
</style>
<div>
    <div class="primary">
        <MoviePlayer MovieId="@MovieId" />
        <div>
            <p>@_movie!.Title</p>
            <p>@_movie!.Description</p>
        </div>
    </div>
</div>

@code {
    private readonly IMovieService _movieService;
    private Movie? _movie;

    [Parameter]
    public required int MovieId
    {
        get;
        init
        {
            field = value;
            _movie = _movieService.GetMovie(value).GetAwaiter().GetResult();
        }
    }

    public MovieView(IMovieService movieService)
    {
        _movieService = movieService;
    }
}
